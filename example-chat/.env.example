# Claude API key (required)
ANTHROPIC_API_KEY=your-anthropic-api-key

# DSE connection — choose ONE mode:

# Option A: Connect to running DSE MCP server via HTTP (recommended with make run-all)
DSE_MCP_URL=http://localhost:8001/mcp

# Option B: Spawn DSE MCP as a subprocess via stdio
# DSE_BACKEND_DIR=../backend

# Default namespace for storing chat memories
DSE_NAMESPACE=user:engineer-dev

# Server port for this chat app (4000 to avoid conflict with DSE frontend on 3000)
PORT=4000
